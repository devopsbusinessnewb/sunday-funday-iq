{
  "manifest_version": 3,
  "name": "CBS Pick'em IQ Bridge",
  "version": "0.5.0",
  "description": "Scans CBS Pick'em data and captures completed-week pool cards for Sunday Funday IQ.",
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://picks.cbssports.com/*",
    "https://www.cbssports.com/nfl/odds/*",
    "https://www.cbssports.com/nfl/odds/"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CBS Pick'em IQ Bridge"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://picks.cbssports.com/*",
        "https://www.cbssports.com/nfl/odds/*",
        "https://www.cbssports.com/nfl/odds/"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://picks.cbssports.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
